{"name":"artcraft_generate_video","description":"Generate videos using ArtCraft's unified OmniGen API. Supports 25+ models including MiniMax H3, Seedance 2.5, Kling 3.0, Sora 2, Veo 3.1, Vidu Q3, Flux 3, and Grok Imagine.","parameters":{"properties":{"aspect_ratio":{"description":"Aspect ratio ('16:9', '9:16', 'square', etc.)","type":"string"},"bitrate":{"description":"Bitrate quality: 'normal' or 'high'","enum":["normal","high"],"type":"string"},"duration_seconds":{"description":"Duration in seconds","type":"integer"},"end_frame_image_media_token":{"description":"Ending keyframe image token","type":"string"},"generate_audio":{"description":"Whether to generate native sound effects/audio","type":"boolean"},"model":{"description":"Model to use (e.g., 'minimax_h3', 'seedance_2p5', 'kling_3p0_pro', 'sora_2_pro', 'veo_3p1', 'vidu_q3', 'wan_3p0', 'flux_3', 'grok_imagine_video')","type":"string"},"negative_prompt":{"description":"Negative prompt (for supported models)","type":"string"},"prompt":{"description":"Text prompt for generation","type":"string"},"quality":{"description":"Quality: 'auto', 'low', 'medium', 'high', 'xhigh', 'max' (model-dependent)","type":"string"},"reference_audio_media_tokens":{"description":"Reference audio tokens","items":{"type":"string"},"type":"array"},"reference_character_tokens":{"description":"Reference character tokens to mention in prompt as @CharacterName","items":{"type":"string"},"type":"array"},"reference_image_media_tokens":{"description":"Reference image tokens","items":{"type":"string"},"type":"array"},"reference_video_media_tokens":{"description":"Reference video tokens","items":{"type":"string"},"type":"array"},"resolution":{"description":"Resolution preset ('480p', '720p', '1080p', '1k', '2k', '4k')","type":"string"},"start_frame_image_media_token":{"description":"Starting keyframe image token","type":"string"},"video_batch_count":{"description":"Number of videos to generate (default: 1)","type":"integer"}},"required":["model","prompt"],"type":"object"}}